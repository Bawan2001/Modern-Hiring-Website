{
    "builds": [
        {
            "src": "Backend/app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/Frontend/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/Backend/app.py"
        }
    ]
}
